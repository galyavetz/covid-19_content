# Gmail address (the account that will SEND emails)
EMAIL_USER=your.gmail@gmail.com

# Gmail App Password (NOT your regular password)
# Go to: Google Account → Security → 2-Step Verification → App passwords
# Generate a password for "Mail" app
EMAIL_PASS=xxxx xxxx xxxx xxxx

# The email address that will RECEIVE the forwarded messages
EMAIL_TO=your.email@gmail.com

# (Optional) Forward only messages from your own number
# Format: country code + number, no + or spaces. Example: 972501234567
# Leave empty to forward ALL incoming messages
MY_PHONE=972501234567
